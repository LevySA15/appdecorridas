# Modelo do arquivo de configuração do servidor.
# Copie para /etc/app-corrida/app.env, troque tudo que começa com TROQUE e deixe só o dono e o grupo "corrida" lerem
# (chmod 640). NUNCA envie o arquivo de verdade para o GitHub.

# Banco de dados (PostgreSQL). A senha é a que você criou no passo do banco.
DATABASE_URL=postgresql://corrida:TROQUE-A-SENHA-DO-BANCO@localhost:5432/corrida
REDIS_URL=redis://localhost:6379/0

# Por enquanto só existe o modo dev: provedores falsos, sem dinheiro de verdade (as integrações reais são o plano 7).
APP_MODE=dev
# off = o servidor não mostra /v1/dev/*, /docs nem /openapi.json. Obrigatório com o servidor aberto na internet.
DEV_ROUTES=off

# Assina os avisos do provedor de pagamento. Gere um com: openssl rand -hex 32
WEBHOOK_SECRET=TROQUE-POR-UM-SEGREDO-LONGO

# Fotos dos documentos dos motoqueiros (dado pessoal: pasta só do serviço).
UPLOAD_DIR=/var/lib/app-corrida/uploads

# Backup diário (server/deploy/backup.sh). Os backups também têm dado pessoal: prazos curtos; o certo é pergunta para o advogado.
BACKUP_DIR=/var/backups/app-corrida
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_UPLOAD_DAYS=7
